{
  "description": "WalletPair core (spec/core.md): how receivers classify messages. A message is given as `message` (a JSON value, sent as its UTF-8 JSON text), `text` (exact text to send, UTF-8), or `oversize` (a wallet_getCallsStatus request with id 1 whose single string parameter is padded with the letter a so that the whole message is the given number of bytes). Wallet cases give the session context: `approved` lists the approved namespaces (empty: unapproved), `recorded` lists ids the Wallet has recorded (spec/core.md §6). The Wallet in these cases supports eip155. Expected outcomes: ignore (no answer), error with code (the Wallet answers the request's id), repeat (send the recorded response again), connect, cancel, perform.",
  "wallet": [
    { "name": "not JSON", "text": "{\"id\":\"1\",", "approved": ["eip155"], "expect": { "action": "ignore" } },
    { "name": "JSON array", "message": [{ "id": "1", "method": "personal_sign" }], "approved": ["eip155"], "expect": { "action": "ignore" } },
    { "name": "JSON string", "message": "hello", "approved": ["eip155"], "expect": { "action": "ignore" } },
    { "name": "byte order mark", "text": "﻿{\"id\":\"1\",\"method\":\"wallet_getCallsStatus\",\"params\":[\"0x01\"]}", "approved": ["eip155"], "expect": { "action": "ignore" } },
    { "name": "exactly 1 MiB", "oversize": 1048576, "approved": ["eip155"], "expect": { "action": "perform" } },
    { "name": "one byte over 1 MiB", "oversize": 1048577, "approved": ["eip155"], "expect": { "action": "ignore" } },
    { "name": "missing id", "message": { "method": "wallet_getCallsStatus", "params": ["0x01"] }, "approved": ["eip155"], "expect": { "action": "ignore" } },
    { "name": "numeric id", "message": { "id": 1, "method": "wallet_getCallsStatus", "params": ["0x01"] }, "approved": ["eip155"], "expect": { "action": "ignore" } },
    { "name": "empty id", "message": { "id": "", "method": "wallet_getCallsStatus", "params": ["0x01"] }, "approved": ["eip155"], "expect": { "action": "ignore" } },
    { "name": "id of 128 characters", "message": { "id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "method": "wallet_getCallsStatus", "params": ["0x01"] }, "approved": ["eip155"], "expect": { "action": "perform" } },
    { "name": "id of 129 characters", "message": { "id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "method": "wallet_getCallsStatus", "params": ["0x01"] }, "approved": ["eip155"], "expect": { "action": "ignore" } },
    { "name": "id with a control character", "message": { "id": "a\nb", "method": "wallet_getCallsStatus", "params": ["0x01"] }, "approved": ["eip155"], "expect": { "action": "ignore" } },
    { "name": "id with non-ASCII", "message": { "id": "é", "method": "wallet_getCallsStatus", "params": ["0x01"] }, "approved": ["eip155"], "expect": { "action": "ignore" } },
    { "name": "missing method", "message": { "id": "1" }, "approved": ["eip155"], "expect": { "action": "error", "code": -32600 } },
    { "name": "method not a string", "message": { "id": "1", "method": 7 }, "approved": ["eip155"], "expect": { "action": "error", "code": -32600 } },
    { "name": "params a string", "message": { "id": "1", "method": "wallet_getCallsStatus", "params": "0x01" }, "approved": ["eip155"], "expect": { "action": "error", "code": -32600 } },
    { "name": "params null", "message": { "id": "1", "method": "wallet_getCallsStatus", "params": null }, "approved": ["eip155"], "expect": { "action": "error", "code": -32600 } },
    { "name": "origin with a path", "message": { "id": "1", "method": "wallet_getCallsStatus", "params": ["0x01"], "origin": "https://app.example/x" }, "approved": ["eip155"], "expect": { "action": "error", "code": -32600 } },
    { "name": "origin not http", "message": { "id": "1", "method": "wallet_getCallsStatus", "params": ["0x01"], "origin": "chrome-extension://abc" }, "approved": ["eip155"], "expect": { "action": "error", "code": -32600 } },
    { "name": "origin with a port", "message": { "id": "1", "method": "wallet_getCallsStatus", "params": ["0x01"], "origin": "http://localhost:3000" }, "approved": ["eip155"], "expect": { "action": "perform" } },
    { "name": "unknown members are ignored", "message": { "id": "1", "method": "wallet_getCallsStatus", "params": ["0x01"], "future": { "x": 1 } }, "approved": ["eip155"], "expect": { "action": "perform" } },
    { "name": "recorded id is answered from the record", "message": { "id": "1", "method": "personal_sign", "params": ["0x68656c6c6f", "0xd8da6bf26964af9d7eed9e03e53415d37aa96045"] }, "approved": ["eip155"], "recorded": ["1"], "expect": { "action": "repeat" } },
    { "name": "unapproved: network function", "message": { "id": "1", "method": "personal_sign", "params": ["0x68656c6c6f", "0xd8da6bf26964af9d7eed9e03e53415d37aa96045"] }, "approved": [], "expect": { "action": "error", "code": 4100 } },
    { "name": "unapproved: unknown function", "message": { "id": "1", "method": "eth_unknown" }, "approved": [], "expect": { "action": "error", "code": 4100 } },
    { "name": "unapproved: connect", "message": { "id": "1", "method": "walletpair_connect", "params": [{ "name": "Example DApp", "namespaces": ["eip155"] }] }, "approved": [], "expect": { "action": "connect" } },
    { "name": "unapproved: cancel", "message": { "id": "2", "method": "walletpair_cancel", "params": ["1"] }, "approved": [], "expect": { "action": "cancel" } },
    { "name": "unknown function", "message": { "id": "1", "method": "eth_unknown" }, "approved": ["eip155"], "expect": { "action": "error", "code": 4200 } },
    { "name": "deliberately unsupported: eth_sign", "message": { "id": "1", "method": "eth_sign", "params": ["0xd8da6bf26964af9d7eed9e03e53415d37aa96045", "0x00"] }, "approved": ["eip155"], "expect": { "action": "error", "code": 4200 } },
    { "name": "connect without namespaces", "message": { "id": "1", "method": "walletpair_connect", "params": [{ "name": "Example DApp" }] }, "approved": [], "expect": { "action": "error", "code": -32602 } },
    { "name": "connect with duplicate namespaces", "message": { "id": "1", "method": "walletpair_connect", "params": [{ "name": "Example DApp", "namespaces": ["eip155", "eip155"] }] }, "approved": [], "expect": { "action": "error", "code": -32602 } },
    { "name": "connect with an invalid namespace", "message": { "id": "1", "method": "walletpair_connect", "params": [{ "name": "Example DApp", "namespaces": ["EIP155"] }] }, "approved": [], "expect": { "action": "error", "code": -32602 } },
    { "name": "connect with an unknown namespace is valid", "message": { "id": "1", "method": "walletpair_connect", "params": [{ "name": "Example DApp", "namespaces": ["cosmos"] }] }, "approved": [], "expect": { "action": "connect" } },
    { "name": "connect params as an object", "message": { "id": "1", "method": "walletpair_connect", "params": { "name": "Example DApp", "namespaces": ["eip155"] } }, "approved": [], "expect": { "action": "error", "code": -32602 } },
    { "name": "connect with a bidi override in the name", "message": { "id": "1", "method": "walletpair_connect", "params": [{ "name": "Pay‮gnp.exe", "namespaces": ["eip155"] }] }, "approved": [], "expect": { "action": "error", "code": -32602 } },
    { "name": "connect with a name of 128 characters", "message": { "id": "1", "method": "walletpair_connect", "params": [{ "name": "😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀", "namespaces": ["eip155"] }] }, "approved": [], "expect": { "action": "connect" } },
    { "name": "connect with a name padded by spaces", "message": { "id": "1", "method": "walletpair_connect", "params": [{ "name": " Example ", "namespaces": ["eip155"] }] }, "approved": [], "expect": { "action": "error", "code": -32602 } },
    { "name": "connect with an http url", "message": { "id": "1", "method": "walletpair_connect", "params": [{ "name": "Example DApp", "url": "http://app.example", "namespaces": ["eip155"] }] }, "approved": [], "expect": { "action": "error", "code": -32602 } },
    { "name": "connect with a localhost url", "message": { "id": "1", "method": "walletpair_connect", "params": [{ "name": "Example DApp", "url": "http://localhost:5173", "namespaces": ["eip155"] }] }, "approved": [], "expect": { "action": "connect" } },
    { "name": "connect with a data icon", "message": { "id": "1", "method": "walletpair_connect", "params": [{ "name": "Example DApp", "icon": "data:image/png;base64,iVBORw0KGgo=", "namespaces": ["eip155"] }] }, "approved": [], "expect": { "action": "connect" } },
    { "name": "connect with a script icon", "message": { "id": "1", "method": "walletpair_connect", "params": [{ "name": "Example DApp", "icon": "data:text/html;base64,PHNjcmlwdD4=", "namespaces": ["eip155"] }] }, "approved": [], "expect": { "action": "error", "code": -32602 } },
    { "name": "cancel without an id", "message": { "id": "2", "method": "walletpair_cancel", "params": [] }, "approved": ["eip155"], "expect": { "action": "error", "code": -32602 } }
  ],
  "dapp": [
    { "name": "response with a result", "message": { "id": "1", "result": "0x01" }, "expect": { "kind": "response" } },
    { "name": "response with a null result", "message": { "id": "1", "result": null }, "expect": { "kind": "response" } },
    { "name": "response with an error", "message": { "id": "1", "error": { "code": 4001, "message": "User rejected the request" } }, "expect": { "kind": "response" } },
    { "name": "error with data", "message": { "id": "1", "error": { "code": 5710, "message": "Unsupported chain id", "data": { "chainId": "0x2" } } }, "expect": { "kind": "response" } },
    { "name": "both result and error", "message": { "id": "1", "result": 1, "error": { "code": 4001, "message": "x" } }, "expect": { "kind": "ignore" } },
    { "name": "neither result nor error", "message": { "id": "1" }, "expect": { "kind": "ignore" } },
    { "name": "error code not an integer", "message": { "id": "1", "error": { "code": 4001.5, "message": "x" } }, "expect": { "kind": "ignore" } },
    { "name": "error without a message", "message": { "id": "1", "error": { "code": 4001 } }, "expect": { "kind": "ignore" } },
    { "name": "response with an invalid id", "message": { "id": "", "result": 1 }, "expect": { "kind": "ignore" } },
    { "name": "state event", "message": { "event": "state", "data": { "eip155": { "chain": "eip155:1", "accounts": ["0xd8da6bf26964af9d7eed9e03e53415d37aa96045"] } } }, "expect": { "kind": "event" } },
    { "name": "event without data", "message": { "event": "state" }, "expect": { "kind": "ignore" } },
    { "name": "unknown event is still an event", "message": { "event": "future", "data": 1 }, "expect": { "kind": "event" } },
    { "name": "a request is ignored", "message": { "id": "1", "method": "personal_sign", "params": [] }, "expect": { "kind": "ignore" } },
    { "name": "not JSON", "text": "nope", "expect": { "kind": "ignore" } }
  ],
  "state": [
    { "name": "empty state", "value": {}, "expect": {} },
    { "name": "EVM state", "value": { "eip155": { "chain": "eip155:137", "accounts": ["0xd8da6bf26964af9d7eed9e03e53415d37aa96045"] } }, "expect": "same" },
    { "name": "unknown namespace is dropped", "value": { "cosmos": { "chain": "cosmos:cosmoshub-4", "accounts": ["cosmos1x"] } }, "expect": {} },
    { "name": "checksummed EVM account", "value": { "eip155": { "chain": "eip155:1", "accounts": ["0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045"] } }, "expect": null },
    { "name": "EVM chain with a leading zero", "value": { "eip155": { "chain": "eip155:01", "accounts": ["0xd8da6bf26964af9d7eed9e03e53415d37aa96045"] } }, "expect": null },
    { "name": "EVM chain in hex", "value": { "eip155": { "chain": "0x1", "accounts": ["0xd8da6bf26964af9d7eed9e03e53415d37aa96045"] } }, "expect": null },
    { "name": "no accounts", "value": { "eip155": { "chain": "eip155:1", "accounts": [] } }, "expect": null },
    { "name": "duplicate accounts", "value": { "eip155": { "chain": "eip155:1", "accounts": ["0xd8da6bf26964af9d7eed9e03e53415d37aa96045", "0xd8da6bf26964af9d7eed9e03e53415d37aa96045"] } }, "expect": null },
    { "name": "state not an object", "value": [], "expect": null }
  ]
}
