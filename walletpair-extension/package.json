{
  "name": "walletpair-extension",
  "description": "WalletPair browser extension: EVM, TRON and Solana apps with a mobile wallet",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/peerconnect.test.ts",
    "test:e2e": "wxt build && tsx e2e/run.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "lucide-svelte": "^1.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@solana/wallet-standard-wallet-adapter-base": "^1.1.7",
    "@solana/web3.js": "^1.99.0",
    "@tronweb3/tronwallet-adapter-tronlink": "^1.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.0.304",
    "@types/qrcode": "^1.5.5",
    "@wallet-standard/app": "^1.1.1",
    "@wxt-dev/module-svelte": "^2.0.4",
    "esbuild": "^0.28.2",
    "puppeteer": "^25.0.4",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tronweb": "^6.5.1",
    "tslib": "^2.8.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "viem": "^2.57.7",
    "vitest": "^4.1.6",
    "wxt": "^0.20.26"
  }
}
