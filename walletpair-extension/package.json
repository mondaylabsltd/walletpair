{
  "name": "walletpair-extension",
  "description": "WalletPair browser extension: EVM apps with a mobile wallet",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "exports": {
    "./walletpair/*": "./src/lib/walletpair/*.ts",
    "./wallet/*": "./src/wallet/*.ts",
    "./display": "./src/lib/display.ts",
    "./peerconnect": "./vendor/peerconnect/index.js"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/peerconnect.test.ts",
    "test:e2e": "wxt build && tsx e2e/run.ts",
    "test:e2e:firefox": "WALLETPAIR_E2E=1 wxt build -b firefox && tsx e2e/firefox.ts",
    "test:e2e:cli": "wxt build && tsx e2e/cli.ts",
    "test:e2e:demo": "pnpm --dir ../walletpair.org build && wxt build && tsx e2e/demo.ts",
    "bench": "tsx test/bench.ts",
    "wallet": "tsx test/wallet/cli.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "lucide-svelte": "^1.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.0.304",
    "@types/qrcode": "^1.5.5",
    "@wxt-dev/module-svelte": "^2.0.4",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "puppeteer": "25.0.4",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tslib": "^2.8.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "viem": "^2.57.7",
    "vitest": "^4.1.6",
    "wxt": "^0.20.26"
  }
}
