{
  "name": "@walletpair/tronwallet-adapter",
  "version": "0.1.0",
  "description": "TRON wallet adapter for WalletPair: use your phone's wallet from TRON dApps through the WalletPair browser extension.",
  "keywords": [
    "TRON",
    "TronWeb",
    "WalletPair",
    "wallet-adapter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/atshelchin/walletpair",
    "directory": "walletpair-tron-adapter"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tronweb3/tronwallet-abstract-adapter": "^1.3.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
